    {
      "id": 2,
      "taskType": "information",
      "title": "What is Scratch?",
      "explainer": "**Scratch** is a way to make **games** and **animations** using **blocks** - No written code required!"
    },
    {
      "id": 3,
      "title": "Say Hello!",
      "explainer": "Each **block** in **Scratch** makes our characters do things! \n\nTry clicking on the `scratch:say (Hello!) for (2) seconds` **block** to make the arrow **Say Hello**!",
      "toolbox": "<xml><category name=\"Looks\" colour=\"#9966FF\"><block type=\"looks_sayforsecs\"/></category></xml>",
      "starterBlocks": {
        "sprite1": {}
      },
      "carryBlocksFrom": 2,
      "sprites": [
        {
          "id": "sprite1",
          "name": "Sprite 1",
          "type": "arrow",
          "x": 0,
          "y": 0,
          "size": 100,
          "direction": 90
        }
      ],
      "completeBlocks": {
        "sprite1": {}
      }
    },
    {
      "id": 4,
      "title": "Putting blocks together",
      "explainer": "We can **put blocks together** in the middle to make them happen one after another! \n\nTry putting the `scratch:move (10) steps` and `scratch:say (Hello!) for (2) seconds` blocks together in the middle!\n\nThen try clicking them!",
      "toolbox": "<xml><category name=\"Motion\" colour=\"#4C97FF\"><block type=\"motion_movesteps\"/></category><category name=\"Looks\" colour=\"#9966FF\"><block type=\"looks_sayforsecs\"/></category></xml>",
      "starterBlocks": {
