rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed-in tutors (role 'teacher') and admins.
    function isStaff() {
      return request.auth != null
             && (request.auth.token.role == 'teacher'
                 || request.auth.token.role == 'admin');
    }

    // Lessons: public read so unauthenticated students can fetch lesson content.
    // Admin writes are allowed for the Builder/Admin Portal and shared CLI tooling.
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.role == 'admin';
    }

    // Topic library: public read so unauthenticated students can fetch topics.
    // Writes restricted to admins.
    match /topicLibrary/{topicId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.role == 'admin';
    }

    // Reusable lesson levels: public read so lesson lists/builders can display
    // level labels; writes restricted to admins.
    match /lessonLevels/{levelId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.role == 'admin';
    }

    // Durable class records used to group admin-created lesson forks.
    // Public read keeps the Builder/Admin selectors simple; writes are admin-only.
    match /classes/{classId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.role == 'admin';

      // Class roster (approved by Ryan 2026-10-14): first name and initial only
      // ({ displayName 1-30 chars, createdAt, createdBy }). NOT public: tutors and admins
      // only. Admins manage it in Admin → Classes; tutors add "New student" in a session.
      // Students never read or write it: the tutor's signed-in client saves a matched
      // student's work (`work`, chunked into `work/{id}/chunks` when large) and typing
      // results (`typing`).
      match /roster/{rosterId} {
        allow read, delete: if isStaff();
        allow create, update: if isStaff()
                              && request.resource.data.keys().hasOnly(['displayName', 'createdAt', 'createdBy'])
                              && request.resource.data.displayName is string
                              && request.resource.data.displayName.size() >= 1
                              && request.resource.data.displayName.size() <= 30;

        match /work/{workId} {
          allow read, write: if isStaff();

          match /chunks/{chunkId} {
            allow read, write: if isStaff();
          }
        }

        match /typing/{entryId} {
          allow read, write: if isStaff();
        }
      }
    }

    // Users: mirrors the Firebase Auth user list.
    // Admins can read all; teachers can only read their own document.
    // Writes are exclusively via Cloud Functions (Admin SDK).
    match /users/{uid} {
      allow read: if request.auth != null
                  && (request.auth.token.role == 'admin'
                      || request.auth.uid == uid);
      allow write: if false;
    }

    // Lesson feedback subcollection: teacher or admin can write; teacher or admin can read.
    // The recursive wildcard path is required for collectionGroup() queries to work.
    match /{path=**}/feedback/{feedbackId} {
      allow read: if request.auth != null
                  && (request.auth.token.role == 'admin'
                      || request.auth.token.role == 'teacher');
      allow write: if request.auth != null
                   && (request.auth.token.role == 'teacher'
                       || request.auth.token.role == 'admin');
    }

    // Lesson report subcollection: one doc per ended session run, written once
    // by the teacher when a session ends or is restarted. Teacher or admin can
    // read/write; recursive wildcard supports collectionGroup() queries.
    match /{path=**}/sessionReports/{reportId} {
      allow read: if request.auth != null
                  && (request.auth.token.role == 'admin'
                      || request.auth.token.role == 'teacher');
      allow write: if request.auth != null
                   && (request.auth.token.role == 'teacher'
                       || request.auth.token.role == 'admin');
    }

    // Lesson-type-wide shared assets and default sprites.
    // Public read so the builder can fetch them without auth.
    match /lessonTypeAssets/{lessonType} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.role == 'admin';
    }

    // Admin badge catalogue: manual-only live badges ({ emoji, title, blurb,
    // archived, updatedAt, updatedBy }). Teachers read it for the award picker;
    // only admins write. Students never read it: an awarded catalogue badge
    // carries its own display snapshot on the RTDB decision.
    match /badgeCatalogue/{badgeId} {
      allow read: if request.auth != null
                  && (request.auth.token.role == 'admin'
                      || request.auth.token.role == 'teacher');
      allow write: if request.auth != null
                   && request.auth.token.role == 'admin';
    }

    // Platform feedback: teacher or admin can write; admin can read.
    match /platformFeedback/{feedbackId} {
      allow read: if request.auth != null
                  && request.auth.token.role == 'admin';
      allow write: if request.auth != null
                   && (request.auth.token.role == 'teacher'
                       || request.auth.token.role == 'admin');
    }
  }
}
