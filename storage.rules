rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Lesson assets are publicly readable; only admins may write.
    match /lessons/{lessonId}/assets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.role == 'admin';
    }

    // Shared lesson-type assets are publicly readable; only admins may write.
    match /shared/{lessonType}/assets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.role == 'admin';
    }
  }
}
