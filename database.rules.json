{
  "rules": {
    "sessions": {
      // Admins can list every session at once (Admin Portal Sessions panel).
      // Per-lesson reads below remain publicly readable regardless of this rule.
      ".read": "auth != null && auth.token.role === 'admin'",

      "$lessonId": {
        ".read": true,

        // Teachers and admins can write any session-level field
        // (state, currentTaskId, teacherLive, sandboxCode, etc.)
        ".write": "auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin')",

        // Any authenticated user can register their name-entry presence marker.
        // The tempId is a client-generated UUID so no UID match is enforced here.
        "joiningStudents": {
          "$tempId": {
            ".write": "auth != null"
          }
        },

        // Students may only write to their own node (auth.uid must match the key).
        // Teachers and admins retain write access for rename, reset, and check override.
        "students": {
          "$anonymousId": {
            ".write": "auth != null && (auth.uid === $anonymousId || auth.token.role === 'teacher' || auth.token.role === 'admin')"
          }
        },

        // Per-task attempt history, keyed the same way as students so each
        // student can only log their own attempts. Sibling of "students" (not
        // nested inside it) so it survives setTaskId's per-task field wipe and
        // is still readable by the teacher at the moment a session ends.
        "attemptLog": {
          "$anonymousId": {
            ".write": "auth != null && (auth.uid === $anonymousId || auth.token.role === 'teacher' || auth.token.role === 'admin')"
          }
        },

        // Student-written metadata for authored carry chains that walked past
        // a skipped immediate source before finding saved work.
        "carryFallbackLog": {
          "$anonymousId": {
            "$taskId": {
              ".write": "auth != null && (auth.uid === $anonymousId || auth.token.role === 'teacher' || auth.token.role === 'admin')"
            }
          }
        },

        // Teacher/admin-only record of students moved past a reportable task
        // without a real passing attempt. Students never write overrides.
        "overrideLog": {
          "$anonymousId": {
            "$taskId": {
              ".write": "auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin')"
            }
          }
        }
      }
    }
  }
}
