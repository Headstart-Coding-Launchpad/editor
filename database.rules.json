{
  "rules": {
    "sessions": {
      // Admins can list every session at once (Admin Portal Sessions panel).
      // Per-lesson reads below remain publicly readable regardless of this rule.
      ".read": "auth != null && auth.token.role === 'admin'",

      "$lessonId": {
        ".read": true,

        // Teachers and admins can write any session-level field
        // (state, currentTaskId, teacherLive, sandboxCode, etc.)
        ".write": "auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin')",

        // Any authenticated user can register their name-entry presence marker
        // ({ joinedAt, typedName?, admit? }). The tempId is a client-generated UUID so no
        // UID match is enforced here. Every write must leave joinedAt in place, so a late
        // typedName or admit can't recreate a marker that was removed on join/disconnect.
        // typedName (what the student is typing) and admit.name are capped at the name
        // input's 30 characters; only teachers/admins can write admit ("Pull in").
        "joiningStudents": {
          "$tempId": {
            ".write": "auth != null",
            ".validate": "newData.hasChild('joinedAt')",
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "typedName": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "admit": {
              ".validate": "(auth.token.role === 'teacher' || auth.token.role === 'admin') && newData.hasChildren(['name', 'at'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },

        // Students may only write to their own node (auth.uid must match the key).
        // Teachers and admins retain write access for rename, reset, and check override.
        "students": {
          "$anonymousId": {
            ".write": "auth != null && (auth.uid === $anonymousId || auth.token.role === 'teacher' || auth.token.role === 'admin')",

            // Live class poll answers ({ choice: option index 0-5, answeredAt }). A student
            // may only answer (or change an answer to) a poll that exists and is open;
            // teachers/admins are not limited to open polls.
            "pollResponses": {
              "$pollId": {
                ".validate": "newData.hasChildren(['choice', 'answeredAt']) && root.child('sessions').child($lessonId).child('polls').child($pollId).exists() && (auth.token.role === 'teacher' || auth.token.role === 'admin' || root.child('sessions').child($lessonId).child('polls').child($pollId).child('status').val() === 'open')",
                "choice": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
                },
                "answeredAt": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        },

        // Live class polls ({ question, options, status, showResults, createdAt, closedAt? }).
        // Teacher/admin write is inherited from $lessonId; there is no student rule, so
        // students only answer, on their own node (students/$anonymousId/pollResponses).
        // activePollId names the poll on students' screens (src/shared/classPolls.js).
        "polls": {
          "$pollId": {
            ".validate": "newData.hasChildren(['question', 'options', 'status', 'createdAt'])",
            "question": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
            },
            "options": {
              "$index": {
                ".validate": "$index.matches(/^[0-5]$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
              }
            },
            "status": {
              ".validate": "newData.val() === 'open' || newData.val() === 'closed'"
            },
            "showResults": {
              ".validate": "newData.isBoolean()"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "closedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "activePollId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "shownResponses": {
          "$responseId": {
            ".validate": "newData.hasChildren(['taskId', 'anonymousId', 'text', 'showName', 'shownAt'])",
            "taskId": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
            },
            "anonymousId": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
            },
            "showName": { ".validate": "newData.isBoolean()" },
            "shownAt": { ".validate": "newData.isNumber()" },
            "hiddenAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        // Per-task attempt history, keyed the same way as students so each
        // student can only log their own attempts. Sibling of "students" (not
        // nested inside it) so it survives setTaskId's per-task field wipe and
        // is still readable by the teacher at the moment a session ends.
        "attemptLog": {
          "$anonymousId": {
            ".write": "auth != null && (auth.uid === $anonymousId || auth.token.role === 'teacher' || auth.token.role === 'admin')"
          }
        },

        // Student-written metadata for authored carry chains that walked past
        // a skipped immediate source before finding saved work.
        "carryFallbackLog": {
          "$anonymousId": {
            "$taskId": {
              ".write": "auth != null && (auth.uid === $anonymousId || auth.token.role === 'teacher' || auth.token.role === 'admin')"
            }
          }
        },

        // Student- or teacher-triggered read-only support stage reveals.
        // These do not modify editor contents and are preserved for reports.
        "supportRevealLog": {
          "$anonymousId": {
            "$taskId": {
              "$stageIndex": {
                ".write": "auth != null && (auth.uid === $anonymousId || auth.token.role === 'teacher' || auth.token.role === 'admin')"
              }
            }
          }
        },

        // Teacher/admin-only record of students moved past a reportable task
        // without a real passing attempt. Students never write overrides.
        "overrideLog": {
          "$anonymousId": {
            "$taskId": {
              ".write": "auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin')"
            }
          }
        },

        // Live badges: the tutor's decisions, one per student per badge
        // ({ status, source, reason, taskId, announce, bulkId, decidedAt, badge? }).
        // Teacher/admin write is inherited from $lessonId; there is no student
        // rule, so students cannot award (or revoke) badges. `badge` is the
        // display snapshot ({ emoji, title, blurb }) of an Admin-catalogue badge,
        // which students can't read from Firestore.
        "badges": {
          "$anonymousId": {
            "$badgeId": {
              ".validate": "newData.hasChildren(['status', 'source', 'decidedAt']) && newData.child('status').val().matches(/^(awarded|dismissed|revoked)$/) && newData.child('source').val().matches(/^(rule|auto|manual)$/)",
              "badge": {
                ".validate": "newData.hasChildren(['emoji', 'title']) && newData.child('emoji').isString() && newData.child('emoji').val().length <= 16 && newData.child('title').isString() && newData.child('title').val().length <= 40 && (!newData.child('blurb').exists() || (newData.child('blurb').isString() && newData.child('blurb').val().length <= 120))"
              }
            }
          }
        },

        // The tutor's badge toggles ({ autoAward, soundsOff }). Teacher-only,
        // inherited from $lessonId.

        // Live badge signals, written by each student for their own id only.
        // No code is stored here. The first-occurrence records can be written
        // once (!data.exists()); the one exception is a topic the teacher sent
        // that the student then opens themselves. Sandbox counters are per-run
        // transactions on the student's own node.
        "studentSignals": {
          "$anonymousId": {
            "topics": {
              "$context": {
                "$taskId": {
                  "$topicId": {
                    ".write": "auth != null && auth.uid === $anonymousId && $context.matches(/^(task|sandbox|personal)$/) && (!data.exists() || (data.child('source').val() === 'teacher' && newData.child('source').val() === 'student'))",
                    ".validate": "newData.hasChildren(['openedAt', 'source']) && newData.child('source').val().matches(/^(student|teacher)$/)"
                  }
                }
              }
            },
            "shortcuts": {
              "$shortcutId": {
                ".write": "auth != null && auth.uid === $anonymousId && !data.exists()",
                ".validate": "newData.hasChildren(['firstUsedAt', 'context'])"
              }
            },
            "autocomplete": {
              ".write": "auth != null && auth.uid === $anonymousId && !data.exists()",
              ".validate": "newData.hasChildren(['firstUsedAt', 'context']) && newData.child('context').val().matches(/^(task|sandbox|personal)$/)"
            },
            "firstEdits": {
              "$taskId": {
                ".write": "auth != null && auth.uid === $anonymousId && !data.exists()",
                ".validate": "newData.child('elapsedMs').isNumber() && newData.child('elapsedMs').val() >= 0"
              }
            },
            "completeShown": {
              "$taskId": {
                ".write": "auth != null && auth.uid === $anonymousId && !data.exists()",
                ".validate": "newData.hasChildren(['at', 'via']) && newData.child('via').val().matches(/^(show|preview|teacherReset)$/)"
              }
            },
            "sandbox": {
              "$kind": {
                ".write": "auth != null && auth.uid === $anonymousId && $kind.matches(/^(session|personal)$/)"
              }
            }
          }
        },

        // Approved workspace shares, index only: who shared, which task, when.
        // Deliberately small, because every client streams the whole session
        // node. The workspace content itself lives in sharedWorkspacePayloads
        // below and is fetched on demand. Teacher/admin write is inherited
        // from $lessonId; no student rule here, so students cannot write it.
        "sharedWorkspaces": {
          "$shareId": {
            // taskId and lessonType are deliberately NOT required: RTDB drops
            // null children, so a share captured with no resolved task would
            // fail validation and surface as PERMISSION_DENIED on approve.
            ".validate": "newData.hasChildren(['sharerId', 'sharedAt'])"
          }
        },

        // Peer help offers (src/shared/peerHelp.js). Visible to the class, and deliberately
        // never naming either student: who is stuck and who is helping live in the
        // teacher-only peerHelp node below. The teacher creates and ends offers. The helper
        // stamps claimedAt in the same update as claiming peerHelp/.../helperId; either
        // student in the pairing may stamp endedAt.
        "peerHelpOffers": {
          "$requestId": {
            "taskId": {
              ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 128)"
            },
            "lessonType": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "offeredAt": {
              ".validate": "newData.isNumber()"
            },
            "claimedAt": {
              ".write": "auth != null && !data.exists() && newData.parent().parent().parent().parent().parent().child('peerHelp').child($lessonId).child($requestId).child('helperId').val() === auth.uid",
              ".validate": "newData.isNumber()"
            },
            "endedAt": {
              ".write": "auth != null && !data.exists() && (root.child('peerHelp').child($lessonId).child($requestId).child('stuckId').val() === auth.uid || root.child('peerHelp').child($lessonId).child($requestId).child('helperId').val() === auth.uid)",
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },

        // Teacher-only peer help switches: notes on/off for this session, and the
        // "End all peer help" pause.
        "peerHelpSettings": {
          "notesEnabled": {
            ".validate": "newData.isBoolean()"
          },
          "pausedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },

        // Students the teacher switched off as helpers for this session. Kept off the
        // students node, which each student can rewrite.
        "peerHelperOff": {
          "$anonymousId": {
            ".validate": "newData.isBoolean()"
          }
        },

        // The teacher's class countdown ({ startedAt, endsAt, durationMs }, server-time ms) or
        // absent. Teacher/admin write is inherited from $lessonId; students cannot write it.
        "classCountdown": {
          ".validate": "newData.hasChildren(['startedAt', 'endsAt', 'durationMs'])",
          "startedAt": { ".validate": "newData.isNumber()" },
          "endsAt": {
            ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('startedAt').val()"
          },
          "durationMs": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "$other": { ".validate": false }
        }
      }
    },

    // Workspace share content, kept outside "sessions" so it is never pushed
    // to every client by the session-wide onValue subscription. Read one entry
    // at a time with get() when a teacher previews a request or a student opens
    // a gallery entry.
    "sharedWorkspacePayloads": {
      "$lessonId": {
        // Teachers/admins manage the whole subtree (approve, remove, clear).
        ".write": "auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin')",

        // A pending snapshot has not been approved yet. Only its author and
        // the teacher may read it - this is what actually enforces the
        // approval gate, rather than hiding a button on the client.
        "pending": {
          "$anonymousId": {
            ".read": "auth != null && (auth.uid === $anonymousId || auth.token.role === 'teacher' || auth.token.role === 'admin')",
            ".write": "auth != null && (auth.uid === $anonymousId || auth.token.role === 'teacher' || auth.token.role === 'admin')"
          }
        },

        // Once approved, the class can read it. Only teachers/admins write.
        "approved": {
          ".read": true
        }
      }
    },

    // ─── Peer help (src/shared/peerHelp.js) ─────────────────────────────────
    // Outside "sessions" so none of it streams to the class. Teachers/admins read and
    // write all of it. A student only ever reads the parts of one request they belong to,
    // and the request id is random, so neither student can find out who the other is.

    // A stuck student's opt-in ("let a classmate help") and their request id.
    "peerHelpRequests": {
      "$lessonId": {
        ".read": "auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin')",
        ".write": "auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin')",
        "$anonymousId": {
          ".read": "auth != null && auth.uid === $anonymousId",
          ".write": "auth != null && auth.uid === $anonymousId",
          ".validate": "newData.hasChildren(['requestId', 'at'])",
          "requestId": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
          },
          "taskId": {
            ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 128)"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },

    // The request a helper is working on, so their client finds it again after a reload.
    "peerHelpHelping": {
      "$lessonId": {
        ".read": "auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin')",
        ".write": "auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin')",
        "$anonymousId": {
          ".read": "auth != null && auth.uid === $anonymousId",
          ".write": "auth != null && auth.uid === $anonymousId",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        }
      }
    },

    // The helper promise, agreed once per session before a first claim.
    "peerHelpPromises": {
      "$lessonId": {
        ".read": "auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin')",
        ".write": "auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin')",
        "$anonymousId": {
          ".read": "auth != null && auth.uid === $anonymousId",
          ".write": "auth != null && auth.uid === $anonymousId",
          ".validate": "newData.isNumber()"
        }
      }
    },

    "peerHelp": {
      "$lessonId": {
        ".read": "auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin')",
        ".write": "auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin')",
        "$requestId": {
          // Written by the stuck student when they ask for help, once.
          "stuckId": {
            ".read": "auth != null && data.val() === auth.uid",
            ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
            ".validate": "newData.isString()"
          },
          // The claim. Written once, by a student who passed the current task, is not the
          // stuck student, has made the helper promise and is not switched off, while the
          // offer is open and peer help is not paused. Readable only by that helper.
          "helperId": {
            ".read": "auth != null && data.val() === auth.uid",
            ".write": "auth != null && !data.exists() && newData.val() === auth.uid && data.parent().child('stuckId').val() !== auth.uid && root.child('sessions').child($lessonId).child('peerHelpOffers').child($requestId).exists() && !root.child('sessions').child($lessonId).child('peerHelpOffers').child($requestId).child('endedAt').exists() && !root.child('sessions').child($lessonId).child('peerHelpOffers').child($requestId).child('claimedAt').exists() && root.child('sessions').child($lessonId).child('peerHelpOffers').child($requestId).child('taskId').val() === root.child('sessions').child($lessonId).child('currentTaskId').val() && (root.child('sessions').child($lessonId).child('students').child(auth.uid).child('checkPassed').val() === true || root.child('sessions').child($lessonId).child('students').child(auth.uid).child('checkOverridePassed').val() === true) && root.child('sessions').child($lessonId).child('students').child(auth.uid).child('checkOverridePassed').val() !== false && !root.child('sessions').child($lessonId).child('peerHelperOff').child(auth.uid).exists() && !root.child('sessions').child($lessonId).child('peerHelpSettings').child('pausedAt').exists() && root.child('peerHelpPromises').child($lessonId).child(auth.uid).exists()",
            ".validate": "newData.isString()"
          },
          // The stuck student's work, written by them (when asking, and on "Get latest").
          "snapshot": {
            ".read": "auth != null && (root.child('peerHelp').child($lessonId).child($requestId).child('stuckId').val() === auth.uid || root.child('peerHelp').child($lessonId).child($requestId).child('helperId').val() === auth.uid)",
            ".write": "auth != null && (root.child('peerHelp').child($lessonId).child($requestId).child('stuckId').val() === auth.uid || newData.parent().child('stuckId').val() === auth.uid) && !root.child('peerHelp').child($lessonId).child($requestId).child('state').child('endedAt').exists()"
          },
          "state": {
            ".read": "auth != null && (root.child('peerHelp').child($lessonId).child($requestId).child('stuckId').val() === auth.uid || root.child('peerHelp').child($lessonId).child($requestId).child('helperId').val() === auth.uid)",
            "endedAt": {
              ".write": "auth != null && !data.exists() && (root.child('peerHelp').child($lessonId).child($requestId).child('stuckId').val() === auth.uid || root.child('peerHelp').child($lessonId).child($requestId).child('helperId').val() === auth.uid)",
              ".validate": "newData.isNumber()"
            },
            "endedBy": {
              ".write": "auth != null && !data.exists() && ((root.child('peerHelp').child($lessonId).child($requestId).child('stuckId').val() === auth.uid && newData.val() === 'stuck') || (root.child('peerHelp').child($lessonId).child($requestId).child('helperId').val() === auth.uid && newData.val() === 'helper'))",
              ".validate": "newData.isString() && newData.val().matches(/^(stuck|helper|teacher|task_changed)$/)"
            },
            "snapshotRequestedAt": {
              ".write": "auth != null && root.child('peerHelp').child($lessonId).child($requestId).child('helperId').val() === auth.uid && !root.child('peerHelp').child($lessonId).child($requestId).child('state').child('endedAt').exists()",
              ".validate": "newData.isNumber()"
            },
            // The stuck student's "Not OK": an alert for the teacher, at any time.
            "notOkAt": {
              ".write": "auth != null && root.child('peerHelp').child($lessonId).child($requestId).child('stuckId').val() === auth.uid",
              ".validate": "newData.isNumber()"
            },
            "notOkSeenAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          // What the stuck student sees. The helper may only add thumbs and preset hints
          // (ids, never text). Edits and notes arrive here only when the teacher approves
          // them. The stuck student may only respond.
          "inbox": {
            ".read": "auth != null && (root.child('peerHelp').child($lessonId).child($requestId).child('stuckId').val() === auth.uid || root.child('peerHelp').child($lessonId).child($requestId).child('helperId').val() === auth.uid)",
            "$itemId": {
              ".write": "auth != null && !data.exists() && root.child('peerHelp').child($lessonId).child($requestId).child('helperId').val() === auth.uid && !root.child('peerHelp').child($lessonId).child($requestId).child('state').child('endedAt').exists() && (newData.child('kind').val() === 'mark' || newData.child('kind').val() === 'hint')",
              ".validate": "newData.hasChildren(['kind', 'createdAt'])",
              "kind": {
                ".validate": "newData.isString() && newData.val().matches(/^(mark|hint|edit|note)$/)"
              },
              "createdAt": {
                ".validate": "newData.isNumber()"
              },
              "file": {
                ".validate": "newData.isString() && newData.val().length <= 128"
              },
              "line": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000"
              },
              "verdict": {
                ".validate": "newData.val() === 'up' || newData.val() === 'down'"
              },
              "hintId": {
                ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_-]{1,40}$/)"
              },
              "text": {
                ".validate": "auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin') && newData.isString() && newData.val().length <= 140"
              },
              "edits": {
                ".validate": "auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin')"
              },
              "reviewItemId": {
                ".validate": "auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin') && newData.isString() && newData.val().length <= 64"
              },
              "response": {
                ".write": "auth != null && root.child('peerHelp').child($lessonId).child($requestId).child('stuckId').val() === auth.uid",
                ".validate": "newData.isString() && newData.val().matches(/^(useful|accepted|declined|not_ok)$/) && (root.child('peerHelp').child($lessonId).child($requestId).child('stuckId').val() === auth.uid || auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin'))"
              },
              "respondedAt": {
                ".write": "auth != null && root.child('peerHelp').child($lessonId).child($requestId).child('stuckId').val() === auth.uid",
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          // Suggested edits and notes waiting for the teacher, plus notes the word filter
          // blocked (kept for the teacher). The helper creates them; only the teacher decides.
          "review": {
            ".read": "auth != null && root.child('peerHelp').child($lessonId).child($requestId).child('helperId').val() === auth.uid",
            "$itemId": {
              ".write": "auth != null && !data.exists() && root.child('peerHelp').child($lessonId).child($requestId).child('helperId').val() === auth.uid && !root.child('peerHelp').child($lessonId).child($requestId).child('state').child('endedAt').exists()",
              ".validate": "newData.hasChildren(['kind', 'status', 'createdAt']) && (newData.child('kind').val() !== 'note' || newData.child('status').val() === 'blocked' || root.child('sessions').child($lessonId).child('peerHelpSettings').child('notesEnabled').val() === true)",
              "kind": {
                ".validate": "newData.isString() && newData.val().matches(/^(edit|note)$/)"
              },
              "status": {
                ".validate": "newData.isString() && (newData.val() === 'pending' || newData.val() === 'blocked' || (auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin') && (newData.val() === 'approved' || newData.val() === 'rejected')))"
              },
              "createdAt": {
                ".validate": "newData.isNumber()"
              },
              "decidedAt": {
                ".validate": "auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin') && newData.isNumber()"
              },
              "file": {
                ".validate": "newData.isString() && newData.val().length <= 128"
              },
              "line": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000"
              },
              "text": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 140"
              },
              "blockedReason": {
                ".validate": "newData.isString() && newData.val().matches(/^(language|contact)$/)"
              },
              "edits": {
                "$index": {
                  ".validate": "$index.matches(/^[0-2]$/) && newData.hasChildren(['line', 'op', 'text', 'before'])",
                  "line": {
                    ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000"
                  },
                  "op": {
                    ".validate": "newData.val() === 'replace' || newData.val() === 'insert'"
                  },
                  "text": {
                    ".validate": "newData.isString() && newData.val().length <= 200"
                  },
                  "before": {
                    ".validate": "newData.isString() && newData.val().length <= 2000"
                  },
                  "$other": {
                    ".validate": false
                  }
                }
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },

    // Teacher-sandbox archive for the session report: one entry per teacher
    // sandbox visit, with the tutor's pushes and each student's last sandbox
    // code. Kept outside "sessions" so it never streams to every client, and
    // no client subscribes to it. Teacher/admin read and write only; students
    // never write here (their snapshots are copied teacher-side).
    "sessionArchive": {
      "$lessonId": {
        ".read": "auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin')",
        ".write": "auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin')"
      }
    },

    // Presentation annotations (live pointer, fading ink, text highlights) from the teacher's
    // Presentation window. Kept outside "sessions" because the pointer moves at ~12Hz and every
    // client streams the whole session node. Readable like a session (students are
    // login-less); only teachers/admins write. Shapes mirror src/app/liveInk/liveInkData.js.
    "liveInk": {
      "$lessonId": {
        ".read": true,
        ".write": "auth != null && (auth.token.role === 'teacher' || auth.token.role === 'admin')",

        // Either { c, dx, dy } (a character + em offset, over text) or { rx, ry } (box fractions).
        "pointer": {
          ".validate": "newData.hasChildren(['surface', 'anchor', 't']) && ((newData.hasChildren(['rx', 'ry']) && !newData.hasChild('c')) || (newData.hasChildren(['c', 'dx', 'dy']) && !newData.hasChild('rx') && !newData.hasChild('ry')))",
          "surface": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
          },
          "anchor": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
          },
          "rx": {
            ".validate": "newData.isNumber() && newData.val() >= -10 && newData.val() <= 10"
          },
          "ry": {
            ".validate": "newData.isNumber() && newData.val() >= -10 && newData.val() <= 10"
          },
          "c": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "dx": {
            ".validate": "newData.isNumber() && newData.val() >= -50 && newData.val() <= 50"
          },
          "dy": {
            ".validate": "newData.isNumber() && newData.val() >= -50 && newData.val() <= 50"
          },
          "t": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },

        "strokes": {
          "$strokeId": {
            ".validate": "newData.hasChildren(['surface', 'anchor', 'points', 't'])",
            "surface": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
            },
            "anchor": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
            },
            "colour": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "t": { ".validate": "newData.isNumber()" },
            // At most 200 points (keys 0-199), each either a [rx, ry] pair of box fractions or
            // a { c, dx, dy } text position (character offset + em offset).
            "points": {
              "$index": {
                ".validate": "$index.matches(/^(1?[0-9]?[0-9])$/) && ((newData.hasChildren(['0', '1']) && !newData.hasChild('c')) || (newData.hasChildren(['c', 'dx', 'dy']) && !newData.hasChild('0') && !newData.hasChild('1')))",
                "$coord": {
                  ".validate": "newData.isNumber() && (($coord.matches(/^[01]$/) && newData.val() >= -10 && newData.val() <= 10) || ($coord === 'c' && newData.val() >= 0 && newData.val() <= 1000000) || (($coord === 'dx' || $coord === 'dy') && newData.val() >= -50 && newData.val() <= 50))"
                }
              }
            },
            "$other": { ".validate": false }
          }
        },

        "highlights": {
          "$highlightId": {
            ".validate": "newData.hasChildren(['surface', 'anchor', 'quote', 'occurrence', 't'])",
            "surface": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
            },
            "anchor": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
            },
            "quote": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
            },
            "occurrence": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000"
            },
            "t": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
