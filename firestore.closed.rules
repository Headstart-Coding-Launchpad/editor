rules_version = '2';

// Hub P24: the rules for the old (default) database after the move to `eu`
// (docs/architecture/firestore-europe-plan.md, Runbook step 3). The app can't read or write it;
// the CLI service account still can, for the copy-back on rollback.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
