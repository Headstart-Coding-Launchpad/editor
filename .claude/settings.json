{
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "C:/Users/rflem/Documents/HSC Hub/scripts/session-brief.mjs",
              "dev"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "C:/Users/rflem/Documents/Ryan Hub/.venv/Scripts/python.exe",
            "args": [
              "C:/Users/rflem/Documents/Ryan Hub/scripts/agent_boot.py",
              "dev"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_discord_discord__reply",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/rflem/Documents/Ryan Hub/.venv/Scripts/python.exe",
            "args": [
              "C:/Users/rflem/Documents/Ryan Hub/scripts/statusguard.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "discord@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run docs:check)",
      "Bash(npm run lint)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-String *)",
      "Read(//c/Users/rflem/Documents/HSC Hub/**)",
      "Edit(/src/**)",
      "Edit(/cli/**)",
      "Edit(/docs/**)",
      "Edit(/tests/**)",
      "Edit(/e2e/**)",
      "Edit(/scripts/**)",
      "Edit(/functions/**)",
      "Edit(/public/**)",
      "Edit(//c/Users/rflem/Documents/HSC Hub/Handoffs.md)",
      "Edit(//c/Users/rflem/Documents/HSC Hub/Status/LaunchPad Dev.md)",
      "Edit(//c/Users/rflem/Documents/HSC Hub/Specs/**)",
      "SendMessage",
      "ListAgents"
    ]
  }
}
